# Copy to .env and adjust for your environment. `.env` is git-ignored.

# --- Application ---
APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Database ---
# DATABASE_URL wins over the POSTGRES_* parts below.
DATABASE_URL=postgresql+psycopg://customer360:local-dev-only@localhost:5432/customer360
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=customer360
# POSTGRES_PASSWORD=local-dev-only
# POSTGRES_DB=customer360

# Log every SQL statement (development only).
SQL_ECHO=false

# Abort a connection attempt after this many seconds.
DB_CONNECT_TIMEOUT=5

# --- File uploads ---
MAX_UPLOAD_BYTES=10485760
UPLOAD_CHUNK_SIZE=1048576
UPLOAD_DIR=var/uploads
