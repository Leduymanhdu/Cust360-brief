# Customer 360 Environment Configuration

APP_ENV=development
PORT=8000

# Database Configuration
# Leave blank to use local SQLite (customer360.db) or provide PostgreSQL connection
# DATABASE_URL=postgresql+psycopg://customer360:local-dev-only@localhost:5432/customer360
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=customer360
# POSTGRES_USER=customer360
# POSTGRES_PASSWORD=local-dev-only

# Security & JWT Configuration
JWT_SECRET_KEY=customer360-development-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
PASSWORD_HASH_ALGORITHM=bcrypt

# Login Lockout Policy
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=30

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
